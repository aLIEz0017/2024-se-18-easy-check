<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easysign.mapper.EventMapper">

    <!-- 防超卖原子操作 -->
    <update id="updateSoldTickets">
        UPDATE event
        SET sold_tickets = sold_tickets + 1
        WHERE id = #{eventId} AND sold_tickets <![CDATA[<]]> total_tickets
    </update>

</mapper>